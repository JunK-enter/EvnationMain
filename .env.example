# ─────────────────────────────────────────────────────────────────────────────
# evNation — environment variables (Next.js)
#
# Copy to `.env.local` for local development.
# Firebase/Pipedrive are optional — the app falls back to localStorage without them.
# ─────────────────────────────────────────────────────────────────────────────

# Copy to `.env.local` for local development (already created if you cloned fresh).
# evnation.us — connect only when deploying to production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z7HNQTWT35

# IONOS serves static HTML only — point API calls at a Node host (e.g. Vercel).
# Set this in IONOS Deploy Now build env AND in Vercel project env.
# Example: https://evnationmain.vercel.app
NEXT_PUBLIC_API_BASE_URL=

# Optional: extra CORS origins for /api/* (comma-separated)
# API_ALLOWED_ORIGINS=https://home-5020869119.app-ionos.space

# Firebase Realtime Database
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Pipedrive — server-side only (never use NEXT_PUBLIC_ for the API token)
# You can paste from EvnationFacebook .env, or run: node scripts/setup-pipedrive-env.mjs
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_SOURCE_CHANNEL=Web forms
PIPEDRIVE_LEAD_SOURCE=Website
# Legacy names from Vite project also work on the server if pasted into .env.local:
# VITE_PIPEDRIVE_API_TOKEN=
# VITE_PIPEDRIVE_COMPANY_DOMAIN=
# VITE_PIPEDRIVE_OWNER_ID=

# Blog editors (optional — override defaults in src/data/blogEditors.js)
NEXT_PUBLIC_BLOG_EDITOR_1_EMAIL=editor@evnation.com
NEXT_PUBLIC_BLOG_EDITOR_1_PASSWORD=green111
NEXT_PUBLIC_BLOG_EDITOR_1_NAME=Blog Editor
NEXT_PUBLIC_BLOG_EDITOR_2_EMAIL=editor2@evnation.com
NEXT_PUBLIC_BLOG_EDITOR_2_PASSWORD=green222
NEXT_PUBLIC_BLOG_EDITOR_2_NAME=Blog Editor 2

# OpenAI (optional — chatbot uses local knowledge if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YouTube featured video for homepage embed (optional — without this, play opens the channel)
# NEXT_PUBLIC_EVNATION_YOUTUBE_VIDEO_ID=

# VITE_FIREBASE_API_KEY= etc.
